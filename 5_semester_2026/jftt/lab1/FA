#!/usr/bin/env python3
import sys

def compute_transition_function(pattern, sigma):
    m = len(pattern)
    delta = {}
    for q in range(m + 1):
        for a in sigma:
            k = min(m, q + 1)
            prefix_a = pattern[:q] + a
            while k > 0 and not prefix_a.endswith(pattern[:k]):
                k -= 1
            delta[(q, a)] = k
    return delta


def finite_automaton_matcher(text, pattern, delta):
    n = len(text)
    m = len(pattern)
    q0 = 0  
    q = q0
    occurrences = []
    
    for i in range(n):
        q = delta.get((q, text[i]), q0)  
        if q == m:  
            occurrences.append(i - m + 1)
            
    return occurrences


def main():
    if len(sys.argv) < 3:
        print(f"Użycie: {sys.argv[0]} <wzorzec> <nazwa_pliku>")
        sys.exit(1)

    pattern = sys.argv[1]
    filename = sys.argv[2]

    try:
        with open(filename, "r", encoding="utf-8") as f:
            text = f.read()
    except FileNotFoundError:
        print(f"Błąd: Nie znaleziono pliku '{filename}'")
        sys.exit(1)
    except Exception as e:
        print(f"Błąd podczas odczytu pliku: {e}")
        sys.exit(1)

    sigma = set(text) | set(pattern)

    delta = compute_transition_function(pattern, sigma)
    occurrences = finite_automaton_matcher(text, pattern, delta)

    for pos in occurrences:
        print(pos)
    print(f"ilosc wystapien {len(occurrences)}")


if __name__ == "__main__":
    main()